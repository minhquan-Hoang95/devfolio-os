{% extends 'base.html.twig' %}

{% block title %}Mes projects {% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        This friendly message is coming from:
        <ul>
            <li>Your controller at <code>/var/www/app/src/Controller/ProjectController.php</code></li>
            <li>Your template at <code>/var/www/app/templates/project/index.html.twig</code></li>
        </ul>
    </div>

    <div style="max-width: 800px; margin: 2rem auto; font-family: sans-serif;">
        <h1>Mes projects ({{ projects|length }}</h1>

        {% for project in projects %}

        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem; margin-bottom: 1rem;" >
            <h2>
                <a href="{{ path('app_project_show', {id: project.id}) }}">
                    {{ project.name }}
                </a>
            </h2>

            <p><strong>Langage :</strong> {{ project.language }}</p>

            <p><small>Créé le {{ project.createdAt|date('d/m/Y')}}</small></p>

            {% if project.githubUrl %}
                <a href="{{ project.githubUrl }}" target="_blank">Voir sur GitHub</a>
            {% endif %}
        </div>
        {% else %}
            <p>Aucun projet pour l'instant.</p>
        {% endfor %}
    </div>

{% endblock %}
